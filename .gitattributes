# Normalize line endings to LF in the repository for all text files. Git auto-detects binary
# vs. text via `text=auto`; the explicit rules below cover common types so behavior doesn't
# depend on each contributor's local `core.autocrlf` setting.
* text=auto eol=lf

# Source and config files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows-specific scripts keep CRLF since they're run by cmd/PowerShell
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.docx binary

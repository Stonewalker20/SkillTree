root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python (matches ruff target-version/PEP 8)
[*.py]
indent_size = 4

# JS/TS/React/JSON/CSS/HTML (matches conventional JS ecosystem defaults)
[*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
